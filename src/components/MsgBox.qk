<lang-ts>
    import { store } from "../util/state"
</lang-ts>

<div
    class="message-box left"
    !class={store.message.left.type}
    !hidden={!store.message.left.value}
    #target={document.body}
>
    {store.message.left.value}
</div>
<div
    class="message-box right"
    !class={
        {
            [store.message.right.type]: true,
            light: store.rightFileTab.activeIndex === 0
        }
    }
    !hidden={!store.message.right.value}
    #target={document.body}
>
    {store.message.right.value}
</div>

<lang-scss>
    .message-box {
        box-sizing: border-box;
        position: absolute;
        z-index: 1;
        bottom: 26px;
        font-size: 13px;
        line-height: 1.6;
        font-weight: 500;
        border-radius: 10px;
        white-space: pre-wrap;
        letter-spacing: 0.3px;
        padding: 10px 14px;
        font-family: monospace;
        box-shadow: var(--shadow);

        &.left {
            left: 26px;
            width: calc(var(--left-editor-width) - 52px);
        }

        &.right {
            right: 26px;
            width: calc(var(--right-editor-width) - 52px);
        }

        &.error {
            color: var(--error-color);
            border: 1px solid var(--error-color);
            background-color: var(--error-color-bg);
        }

        &.warning {
            color: var(--warning-color);
            border: 1px solid var(--warning-color);
            background-color: var(--warning-color-bg);
        }
    }
</lang-scss>
