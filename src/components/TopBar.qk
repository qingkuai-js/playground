<lang-ts>
    import Switch from "./Switch"
    import logo from "../assets/logo.png"
    import VersionSelector from "./VersionSelector"

    import { store } from "../util/state"
    import { refreshCompiledCode } from "../monaco/init"
    import { refreshCodeLens } from "../monaco/languages/provider"
    import { applyQingkuaiTheme } from "../monaco/themes/monakai-spectrum-light"

    function handleChangeCompileOptions(key: "comment" | "debug", value: boolean) {
        ;((store[key] = value), refreshCompiledCode(false))
    }

    function handleToggleTheme() {
        store.theme = store.theme === "light" ? "dark" : "light"
        applyQingkuaiTheme(store.theme)
    }
</lang-ts>

<div class="top-bar">
    <div class="left">
        <img !src={logo} />
        <span>QingKuai Playground</span>
    </div>
    <div class="right">
        <Switch label="code lens" @change={refreshCodeLens} &checked={store.codeLens} />
        <Switch
            label="debug"
            &checked={store.debug}
            @change={(v: boolean) => handleChangeCompileOptions("debug", v)}
        />
        <Switch
            label="comment"
            &checked={store.comment}
            @change={(v: boolean) => handleChangeCompileOptions("comment", v)}
        />
        <VersionSelector package="typescript" />
        <VersionSelector package="qingkuai" />
        <button class="theme-btn" @click={handleToggleTheme}>
            <i class="halo"></i> {store.theme}
        </button>
        <a href="https://github.com/qingkuai-js/qingkuai">
            <i class="iconfont icon-github"></i>
        </a>
    </div>
</div>

<lang-scss>
    .top-bar {
        display: flex;
        height: var(--top-bar-height);
        box-sizing: border-box;
        padding: 0 16px 0 14px;
        align-items: center;
        justify-content: space-between;
        border-radius: var(--radius-panel);
        border: 1px solid var(--line);
        background-color: var(--panel);
        transition:
            background-color 0.25s ease,
            border-color 0.25s ease;

        .left {
            display: flex;
            align-items: center;

            img {
                width: 26px;
                height: 26px;
                border-radius: 6px;
            }

            span {
                font-size: 14px;
                font-weight: bold;
                margin-left: 10px;
                overflow: hidden;
                letter-spacing: 0.5px;
                color: var(--txt);
            }
        }

        .right {
            display: flex;
            align-items: center;

            .theme-btn {
                display: inline-flex;
                height: 28px;
                align-items: center;
                gap: 7px;
                margin-left: 12px;
                padding: 0 12px;
                cursor: pointer;
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.3px;
                color: var(--dim);
                border-radius: var(--radius-control);
                border: 1px solid var(--line);
                background-color: var(--panel);
                transition:
                    color 0.15s ease,
                    border-color 0.15s ease,
                    background-color 0.25s ease;

                &:hover {
                    color: var(--txt);
                    border-color: var(--faint);
                }

                .halo {
                    width: 12px;
                    height: 12px;
                    border-radius: 50%;
                    border: 1px solid currentColor;
                    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
                }
            }

            .iconfont {
                font-size: 22px;
                color: var(--dim);
                margin-left: 16px;
                transition: color 0.2s ease;
            }

            a {
                text-decoration: none;

                &:hover .iconfont {
                    color: var(--txt);
                }
            }
        }
    }
</lang-scss>
