<lang-ts>
    interface Meta {
        props: {
            msg: string
            confirm?: () => void
            cancel?: () => void
        }
        refs: {
            visible: boolean
        }
    }

    function handleCancel() {
        refs.visible = false
        props.cancel?.()
    }

    function handleConfirm() {
        refs.visible = false
        props.confirm?.()
    }

    const documentKeyupEvent = (e: KeyboardEvent) => {
        if (!refs.visible) {
            return
        }
        if (e.key === "Escape") {
            handleCancel()
        } else if (e.key === "Enter") {
            handleConfirm()
        }
    }
    document.addEventListener("keyup", documentKeyupEvent)
    onAfterDestroy(() => {
        document.removeEventListener("keyup", documentKeyupEvent)
    })
</lang-ts>

<div
    tabindex="0"
    class="modal-shadow"
    #if={refs.visible}
    #target={document.body}
    @keyup|esc={handleCancel}
>
    <div class="modal">
        <p class="title">Message</p>
        <p class="info">{props.msg}</p>
        <div class="button-box">
            <button class="cancel-btn" @click={handleCancel}>Cancel</button>
            <button class="confirm-btn" @click={handleConfirm}>Confirm</button>
        </div>
    </div>
</div>

<lang-scss>
    .modal-shadow {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        background-color: var(--mask);
    }
    .modal {
        position: absolute;
        top: 120px;
        z-index: 2;
        width: 400px;
        border-radius: var(--radius-panel);
        border: 1px solid var(--line);
        padding: 16px 18px;
        left: calc(50% - 200px);
        background-color: var(--panel);
        box-shadow: var(--shadow);
        color: var(--txt);

        .title {
            font-size: 15px;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .info {
            font-size: 14px;
            margin-top: 8px;
            color: var(--dim);
            letter-spacing: 0.3px;
        }

        .button-box {
            display: flex;
            justify-content: flex-end;

            button {
                cursor: pointer;
                border: none;
                font-size: 13px;
                font-weight: 500;
                margin-top: 14px;
                padding: 6px 14px;
                margin-left: 12px;
                border-radius: var(--radius-control);
                letter-spacing: 0.5px;

                &.cancel-btn {
                    color: var(--dim);
                    background-color: transparent;
                    border: 1px solid var(--line);

                    &:hover {
                        color: var(--txt);
                        background-color: var(--panel-hover);
                    }
                }
                &.confirm-btn {
                    color: var(--accent-contrast);
                    background-color: var(--accent);

                    &:hover {
                        opacity: 0.85;
                    }
                }
            }
        }
    }
</lang-scss>
