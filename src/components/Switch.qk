<lang-ts>
    interface Meta {
        props: {
            label: string
            defaultChecked?: boolean
            change?: (checked: boolean) => void
        }
        refs: {
            checked?: boolean
        }
    }

    let checked = (refs.checked || props.defaultChecked) ?? false

    function handleChange(e: Event) {
        refs.checked = checked = (e.target as HTMLInputElement).checked
        props.change?.(checked)
    }
</lang-ts>

<div class="switch">
    <span !class={{ active: checked }}>{props.label}</span>
    <label class="outter">
        <input !checked type="checkbox" @change={handleChange} />
        <span class="inner"></span>
    </label>
</div>

<lang-scss>
    .switch {
        display: flex;
        margin-left: 16px;
        align-items: center;

        span {
            font-size: 13px;
            font-weight: 500;
            color: var(--faint);
            letter-spacing: 0.3px;
            transition: color 0.2s ease;

            &.active {
                color: var(--dim);
            }
        }

        .outter {
            position: relative;
            display: inline-block;
            width: 32px;
            height: 18px;
            margin-left: 7px;

            input {
                opacity: 0;
                width: 0;
                height: 0;

                &:checked + .inner {
                    background-color: var(--accent);
                }

                &:checked + .inner::before {
                    background-color: var(--accent-contrast);
                    transform: translateX(14px);
                }
            }

            .inner {
                position: absolute;
                cursor: pointer;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                transition: background-color 0.2s ease;
                border-radius: 18px;
                background-color: var(--line);

                &::before {
                    position: absolute;
                    content: "";
                    height: 14px;
                    width: 14px;
                    left: 2px;
                    bottom: 2px;
                    background-color: var(--faint);
                    transition:
                        transform 0.2s ease,
                        background-color 0.2s ease;
                    border-radius: 50%;
                }
            }
        }
    }
</lang-scss>
