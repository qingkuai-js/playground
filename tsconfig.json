{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["@qingkuai/cli/vite/client"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["src/worker/dts"]
}
